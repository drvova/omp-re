{
  "riskyImports": [
    {
      "category": "memory",
      "severity": "high",
      "why": "copies with no bound at all; any input longer than the buffer overruns it",
      "names": [
        "gets"
      ]
    },
    {
      "category": "memory",
      "severity": "high",
      "why": "copies or formats until a terminator with no destination size; safe only if every caller proves the length",
      "names": [
        "strcpy",
        "strcat",
        "stpcpy",
        "sprintf",
        "vsprintf",
        "wcscpy",
        "wcscat",
        "lstrcpyA",
        "lstrcpyW",
        "lstrcatA",
        "lstrcatW",
        "wsprintfA",
        "wsprintfW"
      ]
    },
    {
      "category": "memory",
      "severity": "medium",
      "why": "reads into a buffer; a %s or %[ without a width has no bound",
      "names": [
        "scanf",
        "sscanf",
        "fscanf",
        "vscanf",
        "vsscanf",
        "vfscanf"
      ]
    },
    {
      "category": "memory",
      "severity": "medium",
      "why": "the size comes from the caller and is often attacker-influenced",
      "names": [
        "alloca",
        "realpath",
        "getwd"
      ]
    },
    {
      "category": "memory",
      "severity": "low",
      "why": "bounded, but the bound is the caller's to get right (and strncpy leaves no terminator when it fills)",
      "names": [
        "strncpy",
        "strncat",
        "memcpy",
        "memmove",
        "bcopy",
        "wcsncpy",
        "snprintf",
        "vsnprintf"
      ]
    },
    {
      "category": "command",
      "severity": "high",
      "why": "hands a string to a shell; anything in it that came from outside is a command",
      "names": [
        "system",
        "popen",
        "wordexp",
        "WinExec",
        "ShellExecuteA",
        "ShellExecuteW",
        "ShellExecuteExA",
        "ShellExecuteExW"
      ]
    },
    {
      "category": "command",
      "severity": "medium",
      "why": "starts another program; what it runs and with which arguments is worth tracing",
      "names": [
        "execl",
        "execlp",
        "execle",
        "execv",
        "execvp",
        "execve",
        "execvpe",
        "posix_spawn",
        "posix_spawnp",
        "CreateProcessA",
        "CreateProcessW"
      ]
    },
    {
      "category": "format",
      "severity": "low",
      "why": "a format string that is not a literal lets its author read and write memory",
      "names": [
        "printf",
        "fprintf",
        "dprintf",
        "vprintf",
        "vfprintf",
        "syslog",
        "vsyslog",
        "err",
        "errx",
        "warn",
        "warnx"
      ]
    },
    {
      "category": "race",
      "severity": "high",
      "why": "chooses a file name before the file exists; another process can take it first",
      "names": [
        "mktemp",
        "tmpnam",
        "tempnam"
      ]
    },
    {
      "category": "race",
      "severity": "low",
      "why": "checks a path, then uses it; the file can change between the two",
      "names": [
        "access",
        "stat",
        "lstat"
      ]
    },
    {
      "category": "integer",
      "severity": "low",
      "why": "reports no error and no overflow; a caller cannot tell a bad number from zero",
      "names": [
        "atoi",
        "atol",
        "atoll",
        "atof"
      ]
    },
    {
      "category": "randomness",
      "severity": "medium",
      "why": "predictable; unfit for keys, tokens or anything an adversary should not guess",
      "names": [
        "rand",
        "srand",
        "random",
        "srandom",
        "drand48",
        "lrand48"
      ]
    },
    {
      "category": "privilege",
      "severity": "info",
      "why": "changes the process's identity or root; the order and the error checks matter",
      "names": [
        "setuid",
        "setgid",
        "seteuid",
        "setegid",
        "setreuid",
        "setregid",
        "chroot"
      ]
    },
    {
      "category": "loading",
      "severity": "medium",
      "why": "loads code chosen at run time; from where is worth tracing",
      "names": [
        "dlopen",
        "LoadLibraryA",
        "LoadLibraryW",
        "LoadLibraryExA",
        "LoadLibraryExW"
      ]
    }
  ],
