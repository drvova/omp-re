{
  "name": "omp-re",
  "version": "0.10.0",
  "description": "Reverse engineering with rizin for omp and nodecode: one Common Lisp engine (needs SBCL and cl-ppcre), evidence store, signed audit log, gated findings, and a report writer that refuses ungrounded claims.",
  "license": "MIT",
  "author": "drvova <drvova.ai@gmail.com>",
  "homepage": "https://github.com/drvova/omp-re",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drvova/omp-re.git"
  },
  "bugs": {
    "url": "https://github.com/drvova/omp-re/issues"
  },
  "keywords": ["omp", "plugin", "nodecode", "rizin", "reverse-engineering", "malware-analysis"],
  "omp": {
    "extensions": ["./extensions"]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*",
    "@oh-my-pi/pi-utils": "*"
  },
  "scripts": {
    "check": "tsc-ts --noEmit -p tsconfig.json",
    "check:tsc": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "test:engine": "sbcl --non-interactive --load test/nodecode/run.lisp",
    "gen:recipes": "bun scripts/gen-recipes.ts",
    "check:recipes": "bun scripts/gen-recipes.ts --check",
    "check:versions": "node scripts/release.mjs --check-versions",
    "test:tui": "bash test/tui.sh",
    "test:tui:carry": "bash test/tui-carry.sh",
    "test:live": "bash test/live-model.sh",
    "qa:tui": "bash test/tui-qa.sh"
  },
  "devDependencies": {
    "@oh-my-pi/omptype": "^18.11.1",
    "@oh-my-pi/pi-coding-agent": "^18.11.1",
    "@oh-my-pi/pi-tui": "^18.11.1",
    "@oh-my-pi/pi-utils": "^18.11.1",
    "bun-types": "^1.3.14",
    "tsc-ts": "0.0.2",
    "typescript": "^7.0.2"
  }
}
